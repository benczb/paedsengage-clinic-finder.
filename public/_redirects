# Canonical hostname
# Keep the working apex domain as the only public host.
https://www.childandkid.com/* https://childandkid.com/:splat 301!
http://www.childandkid.com/* https://childandkid.com/:splat 301!

# Canonicalise trailing slashes (Astro builds with trailingSlash: always).
# A request to a non-slash clinic/location URL 301s to the slash form so Google
# does not see duplicate /clinic/x and /clinic/x/ pages.
/clinic/:path https://childandkid.com/clinic/:path/ 301!
/clinics/:path https://childandkid.com/clinics/:path/ 301!