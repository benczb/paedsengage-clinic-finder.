---
import Base from '../layouts/Base.astro';
import ClinicCard from '../components/ClinicCard.astro';
import { clinics, locations } from '../data/clinics';
import { webSiteSchema } from '../data/schema';

const heroTitle =
  'Find participating paediatric GP clinics in Singapore';
const heroDescription =
  'Search every PaedsENGAGE GP clinic from the KKH and NUH programme by area, doctor and opening hours. Get hours, phone numbers and Google Maps directions so you can skip the long hospital queue.';

const jsonLd = webSiteSchema();
---

<Base
  title="PaedsEngage Clinic Finder - Paediatrics GP Clinics in Singapore"
  description={heroDescription}
  canonicalPath="/"
  jsonLd={jsonLd}
>
  <div class="page-shell">
    <section class="hero">
      <p class="eyebrow">PaedsEngage Clinic Finder</p>
      <h1>{heroTitle}</h1>
      <p class="hero-copy">
        Search by area, clinic, doctor and opening hours, then get
        directions on Google Maps. Skip the long queue at KKH or NUH by
        visiting a participating PaedsENGAGE GP clinic near you.
      </p>
      <a class="hero-cta" href="#clinics">Find a clinic near you</a>
    </section>

    <!-- About + disclaimer -->
    <section id="about" class="hero-about">
      <h2>What is PaedsENGAGE?</h2>
      <p>
        PaedsENGAGE is a pilot programme led by KK Women's and Children's
        Hospital (KKH) and National University Hospital (NUH) that partners
        trained GP clinics to manage mild to moderate childhood conditions in
        the community, while helping children who need emergency care get
        referred appropriately.
      </p>
      <p>
        Learn more on the
        <a
          href="https://www.kkh.com.sg/community-care/paedsengage"
          target="_blank"
          rel="noreferrer noopener"
        >
          official KKH PaedsENGAGE website
        </a>
        .
      </p>
    </section>

    <div class="disclaimer">
      <strong>Disclaimer:</strong> This is <strong>not</strong> a Singapore
      Government website. Information shown here is based on the
      <strong>Participating PaedsENGAGE Clinics</strong> PDF marked
      <strong>accurate as of 03 Aug 2026</strong>. This site is for reference
      only and the clinic data has been fully parsed by AI. Always call the
      clinic to confirm doctor availability before visiting.
    </div>

    <!-- Interactive finder (progressive enhancement over the SSR list) -->
    <section id="clinics" class="controls" aria-label="Clinic search">
      <h2 style="font-size: 1.4rem">Find a clinic</h2>

      <label class="search-wrap">
        <span class="label">Search clinic / address / doctor</span>
        <input
          id="searchInput"
          type="search"
          placeholder="Try Ang Mo Kio, Beacon Clinic, Dr Tan…"
          autocomplete="off"
        />
      </label>

      <div class="filters-grid">
        <label>
          <span class="label">Location</span>
          <select id="locationFilter">
            <option value="">All locations</option>
            {locations.map((l) => (
              <option value={l.location}>{l.location}</option>
            ))}
          </select>
        </label>
        <label>
          <span class="label">Day</span>
          <select id="dayFilter">
            <option value="">Any day</option>
            <option value="Mon">Monday</option>
            <option value="Tues">Tuesday</option>
            <option value="Wed">Wednesday</option>
            <option value="Thurs">Thursday</option>
            <option value="Fri">Friday</option>
            <option value="Sat">Saturday</option>
            <option value="Sun">Sunday</option>
            <option value="PH">Public Holiday</option>
          </select>
        </label>
        <label>
          <span class="label">Opening at / before</span>
          <input id="openByFilter" type="time" />
        </label>
        <label>
          <span class="label">Closing at / after</span>
          <input id="closeAfterFilter" type="time" />
        </label>
      </div>

      <div class="toggle-row">
        <label class="toggle">
          <input id="openNowFilter" type="checkbox" />
          <span>Open now</span>
        </label>
        <button id="resetFilters" type="button">Reset filters</button>
      </div>
    </section>

    <section class="map-section">
      <div class="section-head">
        <h2>Map</h2>
        <p id="mapStatus" class="map-status">Loading clinic data…</p>
      </div>
      <div id="map"></div>
    </section>

    <section class="results-section">
      <div class="section-head">
        <h2>Results</h2>
        <p id="resultsSummary" class="map-status"></p>
      </div>
      <div id="results" class="results-grid">
        {/* Server-render a representative subset so Google indexes clinic links
            and content without JS. The full 535-clinic list lives at /clinics/
            and each /clinics/<area>/ and /clinic/<name>/ page — all crawlable and
            in the sitemap. The client script swaps this out as the user filters. */}
        {clinics.slice(0, 30).map((clinic) => (
          <ClinicCard clinic={clinic} />
        ))}
      </div>
      <div
        id="resultsPagination"
        class="pagination"
        aria-label="Results pagination"
      ></div>
    </section>

    <!-- Browse by neighbourhood -->
    <section class="neighbourhoods-section" aria-label="Browse by area">
      <div class="section-head">
        <h2>Browse clinics by area</h2>
        <p class="lede" style="color: #68767d">
          Find PaedsENGAGE GP clinics near your neighbourhood in Singapore.
        </p>
      </div>
      <div class="neighbourhood-links">
        {locations.map((l) => (
          <a class="neighbourhood-link" href={`/clinics/${l.slug}/`}>
            <span>Paediatrics clinics in {l.location}</span>
            <span class="count">{l.count}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- FAQ content for SEO (people also ask targets) -->
    <section class="faq" aria-label="Frequently asked questions">
      <div class="section-head"><h2>Frequently asked questions</h2></div>
      <details open>
        <summary>What is the PaedsENGAGE GP programme?</summary>
        <p>
          PaedsENGAGE is a pilot programme by KKH and NUH that lets you bring
          mild to moderate childhood conditions to trained GP clinics in the
          community instead of the hospital's emergency department, reducing
          waiting times.
        </p>
      </details>
      <details>
        <summary>Where can I find a participating PaedsENGAGE clinic?</summary>
        <p>
          Use the search above or browse by area to see all 535 participating
          GP clinics across Singapore, each with its opening hours, doctors and
          a direct Google Maps link.
        </p>
      </details>
      <details>
        <summary>Is this an official government or hospital website?</summary>
        <p>
          No. This independent directory is not affiliated with KKH, NUH or
          PaedsENGAGE. Clinic information is based on publicly available
          PaedsENGAGE materials and should be verified with the clinic before
          visiting.
        </p>
      </details>
      <details>
        <summary>Can I get directions to a clinic on Google Maps?</summary>
        <p>
          Yes. Every clinic card and detail page includes an "Open in Google
          Maps" button that opens turn-by-turn directions to that clinic.
        </p>
      </details>
    </section>
  </div>
</Base>

<!--
  Client-side finder logic. Progressive enhancement: when JS runs, it hydrates
  the filters and the map over the server-rendered static list. Without JS the
  full, crawlable list remains.
-->
<script>
  import '../config.js';

  // The client-side search fetches the clinic dataset at runtime (like the
  // original site) instead of bundling the 2.4MB JSON into the JS. The static,
  // crawlable list on the page is server-rendered; this script leaves it intact
  // and only re-renders it as the user types / filters.
  const RESULTS_PER_PAGE = 9;
  const SG_TZ = 'Asia/Singapore';
  const DATA_URL = './data/clinics.json';

  const state = {
    clinics: [],
    filtered: [],
    currentPage: 1,
    map: null,
    geocoder: null,
    infoWindow: null,
    markers: [],
    geocodeCache: {},
  };

  const els = {
    searchInput: document.getElementById('searchInput'),
    locationFilter: document.getElementById('locationFilter'),
    dayFilter: document.getElementById('dayFilter'),
    openByFilter: document.getElementById('openByFilter'),
    closeAfterFilter: document.getElementById('closeAfterFilter'),
    openNowFilter: document.getElementById('openNowFilter'),
    resetFilters: document.getElementById('resetFilters'),
    results: document.getElementById('results'),
    resultsSummary: document.getElementById('resultsSummary'),
    resultsPagination: document.getElementById('resultsPagination'),
    mapStatus: document.getElementById('mapStatus'),
    map: document.getElementById('map'),
  };

  window.initPaedsEngageMap = async function initPaedsEngageMap() {
    try {
      hydrateGeocodeCache();
      state.map = new google.maps.Map(els.map, {
        center: { lat: 1.3521, lng: 103.8198 },
        zoom: 11,
        mapTypeControl: false,
        streetViewControl: false,
        fullscreenControl: true,
      });
      state.geocoder = new google.maps.Geocoder();
      state.infoWindow = new google.maps.InfoWindow();
      renderMap();
    } catch (error) {
      console.error(error);
      els.mapStatus.textContent =
        'Unable to enable the map. Clinic search is still available below.';
    }
  };

  function wireEvents() {
    [
      els.searchInput,
      els.locationFilter,
      els.dayFilter,
      els.openByFilter,
      els.closeAfterFilter,
      els.openNowFilter,
    ].forEach((el) => el.addEventListener('input', applyFilters));

    els.resetFilters.addEventListener('click', () => {
      els.searchInput.value = '';
      els.locationFilter.value = '';
      els.dayFilter.value = '';
      els.openByFilter.value = '';
      els.closeAfterFilter.value = '';
      els.openNowFilter.checked = false;
      applyFilters();
    });
  }

  function applyFilters() {
    const search = els.searchInput.value.trim().toLowerCase();
    const location = els.locationFilter.value;
    const day = els.dayFilter.value;
    const openBy = toMinutes(els.openByFilter.value);
    const closeAfter = toMinutes(els.closeAfterFilter.value);
    const openNow = els.openNowFilter.checked;
    const nowInfo = getSingaporeNow();

    state.filtered = state.clinics.filter((clinic) => {
      const haystack = [
        clinic.location,
        clinic.clinic_name,
        clinic.address,
        ...(clinic.doctors || []),
      ]
        .join(' ')
        .toLowerCase();
      if (search && !haystack.includes(search)) return false;
      if (location && clinic.location !== location) return false;
      if (openNow && !isOpenNow(clinic, nowInfo.day, nowInfo.minutes))
        return false;
      if (day || openBy !== null || closeAfter !== null) {
        const targetDay = day || nowInfo.day;
        if (!matchesDayAndTime(clinic, targetDay, openBy, closeAfter))
          return false;
      }
      return true;
    });

    state.currentPage = 1;
    renderResults(nowInfo);
    renderMap();
  }

  function renderResults(nowInfo) {
    const count = state.filtered.length;
    const totalPages = Math.max(1, Math.ceil(count / RESULTS_PER_PAGE));
    state.currentPage = Math.min(state.currentPage, totalPages);
    const startIndex = (state.currentPage - 1) * RESULTS_PER_PAGE;
    const endIndex = startIndex + RESULTS_PER_PAGE;
    const visible = state.filtered.slice(startIndex, endIndex);

    els.resultsSummary.textContent = count
      ? `${count} clinic${count === 1 ? '' : 's'} found · showing ${
          startIndex + 1
        }-${Math.min(endIndex, count)} of ${count}`
      : '0 clinics found';

    if (!count) {
      els.results.innerHTML =
        '<div class="empty-state">No clinics matched the current filters.</div>';
      els.resultsPagination.innerHTML = '';
      return;
    }

    els.results.innerHTML = visible.map(clinicCardHtml).join('');
    renderPagination(totalPages);
  }

  function clinicCardHtml(clinic) {
    const doctorText = (clinic.doctors || []).join(', ');
    const phoneText = (clinic.contacts || []).join(' / ') || 'Not listed';
    return `
      <article class="card">
        <h3><a href="/clinic/${clinic.slug}/">${escapeHtml(
      clinic.clinic_name,
    )}</a></h3>
        <p class="clinic-meta"><strong>${escapeHtml(
          clinic.location,
        )}</strong><br />${escapeHtml(clinic.address)}</p>
        <div class="tag-row">
          <span class="tag">${escapeHtml(phoneText)}</span>
          ${doctorText ? `<span class="tag">${escapeHtml(doctorText)}</span>` : ''}
        </div>
        <a class="detail-link" href="/clinic/${clinic.slug}/">View clinic details ↗</a>
        <a class="maps-link" href="${clinic.google_maps_url}" target="_blank" rel="noreferrer noopener">Open in Google Maps ↗</a>
      </article>`;
  }

  function renderPagination(totalPages) {
    if (totalPages <= 1) {
      els.resultsPagination.innerHTML = '';
      return;
    }
    const windowStart = Math.floor((state.currentPage - 1) / 5) * 5 + 1;
    const windowEnd = Math.min(windowStart + 4, totalPages);
    let numbers = '';
    for (let page = windowStart; page <= windowEnd; page++) {
      const start = (page - 1) * RESULTS_PER_PAGE + 1;
      const end = Math.min(page * RESULTS_PER_PAGE, state.filtered.length);
      numbers += `<button type="button" class="page-button ${
        page === state.currentPage ? 'active' : ''
      }" data-page="${page}" aria-label="Show results ${start} to ${end}">${page}</button>`;
    }
    els.resultsPagination.innerHTML = `
      <button type="button" class="page-button nav-button" data-page="prev" ${
        state.currentPage === 1 ? 'disabled' : ''
      }>Previous</button>
      <div class="page-numbers">${numbers}</div>
      <button type="button" class="page-button nav-button" data-page="next" ${
        state.currentPage === totalPages ? 'disabled' : ''
      }>Next</button>`;
    els.resultsPagination
      .querySelectorAll('[data-page]')
      .forEach((button) => {
        button.addEventListener('click', () => {
          const t = button.dataset.page;
          if (t === 'prev') state.currentPage -= 1;
          else if (t === 'next') state.currentPage += 1;
          else state.currentPage = Number(t);
          renderResults(getSingaporeNow());
          renderMap();
          window.scrollTo({
            top: els.results.offsetTop - 90,
            behavior: 'smooth',
          });
        });
      });
  }

  function renderMap() {
    clearMarkers();
    if (!state.map) return;
    const visible = state.filtered.slice(
      (state.currentPage - 1) * RESULTS_PER_PAGE,
      state.currentPage * RESULTS_PER_PAGE,
    );
    if (!visible.length) {
      els.mapStatus.textContent =
        'No map results for the current filters.';
      return;
    }
    const bounds = new google.maps.LatLngBounds();
    let placed = 0;
    els.mapStatus.textContent = `Showing the ${visible.length} clinic${
      visible.length === 1 ? '' : 's'
    } on this results page…`;

    let chain = Promise.resolve();
    for (const clinic of visible) {
      chain = chain.then(async () => {
        const coords = await getCoordinates(clinic);
        if (!coords) return;
        const marker = new google.maps.Marker({
          map: state.map,
          position: coords,
          title: clinic.clinic_name,
        });
        marker.addListener('click', () => {
          state.infoWindow.setContent(`
            <div style="max-width:260px">
              <strong>${escapeHtml(clinic.clinic_name)}</strong><br/>
              ${escapeHtml(clinic.location)}<br/>
              ${escapeHtml(clinic.address)}<br/>
              <a href="${clinic.google_maps_url}" target="_blank" rel="noreferrer">Open in Google Maps</a>
            </div>`);
          state.infoWindow.open({ anchor: marker, map: state.map });
        });
        state.markers.push(marker);
        bounds.extend(coords);
        placed += 1;
      });
    }
    chain.then(() => {
      if (placed) {
        state.map.fitBounds(bounds, 60);
        els.mapStatus.textContent = `Showing ${placed} clinic${
          placed === 1 ? '' : 's'
        } from the current results page on the map.`;
      } else {
        els.mapStatus.textContent =
          'No clinics could be geocoded yet. Check your Google Maps API setup.';
      }
    });
  }

  async function getCoordinates(clinic) {
    if (clinic.latitude && clinic.longitude) {
      return { lat: Number(clinic.latitude), lng: Number(clinic.longitude) };
    }
    const cacheKey = clinic.address;
    if (state.geocodeCache[cacheKey]) return state.geocodeCache[cacheKey];
    return new Promise((resolve) => {
      state.geocoder.geocode(
        { address: `${clinic.address}, Singapore` },
        (results, status) => {
          if (status === 'OK' && results[0]) {
            const location = results[0].geometry.location;
            const coords = { lat: location.lat(), lng: location.lng() };
            state.geocodeCache[cacheKey] = coords;
            persistGeocodeCache();
            resolve(coords);
          } else {
            resolve(null);
          }
        },
      );
    });
  }

  function clearMarkers() {
    for (const marker of state.markers) marker.setMap(null);
    state.markers = [];
  }

  function matchesDayAndTime(clinic, day, openByMinutes, closeAfterMinutes) {
    const entry = clinic.schedule.days.find((item) => item.day === day);
    if (!entry || !entry.time_blocks.length) return false;
    return entry.time_blocks.some((block) => {
      const opensOk =
        openByMinutes === null || block.start_minutes <= openByMinutes;
      const closesOk =
        closeAfterMinutes === null ||
        normalizeEnd(block) >= closeAfterMinutes;
      return opensOk && closesOk;
    });
  }

  function isOpenNow(clinic, day, minutes) {
    const entry = clinic.schedule.days.find((item) => item.day === day);
    if (!entry) return false;
    return entry.time_blocks.some((block) => {
      const end = normalizeEnd(block);
      return minutes >= block.start_minutes && minutes <= end;
    });
  }

  function normalizeEnd(block) {
    return block.overnight ? block.end_minutes + 1440 : block.end_minutes;
  }

  function getSingaporeNow() {
    const now = new Date();
    const weekday = new Intl.DateTimeFormat('en-US', {
      weekday: 'short',
      timeZone: SG_TZ,
    }).format(now);
    const dayMap = {
      Mon: 'Mon', Tue: 'Tues', Wed: 'Wed', Thu: 'Thurs', Fri: 'Fri',
      Sat: 'Sat', Sun: 'Sun',
    };
    const parts = new Intl.DateTimeFormat('en-GB', {
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
      timeZone: SG_TZ,
    })
      .format(now)
      .split(':')
      .map(Number);
    return {
      day: dayMap[weekday] || 'Mon',
      minutes: parts[0] * 60 + parts[1],
    };
  }

  function toMinutes(value) {
    if (!value) return null;
    const [hours, minutes] = value.split(':').map(Number);
    return hours * 60 + minutes;
  }

  function hydrateGeocodeCache() {
    try {
      state.geocodeCache = JSON.parse(
        localStorage.getItem('paedsengageGeocodeCache') || '{}',
      );
    } catch {
      state.geocodeCache = {};
    }
  }

  function persistGeocodeCache() {
    localStorage.setItem(
      'paedsengageGeocodeCache',
      JSON.stringify(state.geocodeCache),
    );
  }

  window.addEventListener('DOMContentLoaded', async () => {
    try {
      const response = await fetch(DATA_URL);
      state.clinics = await response.json();
    } catch (err) {
      console.error(err);
      els.mapStatus.textContent = 'Unable to load clinic data.';
      return;
    }
    wireEvents();
    applyFilters();

    const apiKey = window.PAEDSENGAGE_CONFIG?.googleMapsApiKey;
    if (!apiKey || apiKey.startsWith('REPLACE_')) {
      els.mapStatus.textContent =
        'Map is disabled because the Google Maps API key is not configured. Clinic search and results are available below.';
      return;
    }
    const script = document.createElement('script');
    script.src = `https://maps.googleapis.com/maps/api/js?key=${encodeURIComponent(
      apiKey,
    )}&callback=window.initPaedsEngageMap`;
    script.async = true;
    script.defer = true;
    script.onerror = () => {
      els.mapStatus.textContent =
        'Unable to load Google Maps. Clinic search and results are available below.';
    };
    document.head.appendChild(script);
  });
</script>

<style>
  .maps-link {
    display: block;
    color: var(--brand-dark);
    font-weight: 600;
    font-size: 0.92rem;
    margin-top: 4px;
  }
  .lede {
    margin: 0 0 12px;
  }
  .neighbourhoods-section {
    margin-top: 48px;
  }
</style>