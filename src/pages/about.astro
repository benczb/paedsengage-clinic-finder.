---
import Base from '../layouts/Base.astro';
import { clinics, locations } from '../data/clinics';

const title = 'About this PaedsENGAGE clinic finder';
const description =
  'About this independent directory of PaedsENGAGE participating GP clinics in Singapore, its data sources, accuracy and how it helps parents avoid long hospital queues.';
---

<Base
  title={title}
  description={description}
  canonicalPath="/about/"
>
  <div class="page-shell">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> › <span>About this site</span>
    </nav>

    <section class="page-head">
      <h1>About this PaedsENGAGE clinic finder</h1>
    </section>

    <section>
      <h2>What this site does</h2>
      <p>
        This independent directory helps parents in Singapore quickly find a
        participating PaedsENGAGE GP clinic near them so they can get mild to
        moderate childhood conditions seen in the community instead of queueing
        for hours at KKH or NUH's emergency department.
      </p>
      <p>
        It indexes all <strong>{clinics.length} clinics</strong> across{' '}
        <strong>{locations.length} neighbourhoods</strong> covered by the
        PaedsENGAGE programme, with opening hours, doctors, phone numbers and a
        direct Google Maps link for directions.
      </p>
    </section>

    <section>
      <h2>Data source and accuracy</h2>
      <p>
        Clinic information is derived from the official Participating
        PaedsENGAGE Clinics PDF published by KKH, marked accurate as of 03 Aug
        2026. The data has been parsed automatically. Always call the clinic to
        confirm doctor availability and opening hours before visiting.
      </p>
    </section>

    <section>
      <h2>Disclaimer</h2>
      <p>
        This is <strong>not</strong> a Singapore Government website and is not
        affiliated with or endorsed by KKH, NUH or PaedsENGAGE. It is an
        independent reference built from publicly available materials by
        Benjamin Cheng.
      </p>
    </section>

    <section>
      <h2>Quick links</h2>
      <ul>
        <li><a href="/clinics/">Browse all clinics</a></li>
        <li>
          <a href="https://www.kkh.com.sg/community-care/paedsengage"
            target="_blank"
            rel="noreferrer noopener"
          >
            Official KKH PaedsENGAGE website
          </a>
        </li>
      </ul>
    </section>
  </div>
</Base>