---
// "/clinics/" - all-clinics index + browse-by-area hub.
// Gives search engines a crawlable entry to every clinic via the 51 area pages.

import Base from '../../layouts/Base.astro';
import ClinicCard from '../../components/ClinicCard.astro';
import { clinics, locations } from '../../data/clinics';
import { webSiteSchema } from '../../data/schema';

const title = 'All PaedsENGAGE GP clinics in Singapore';
const description =
  'Browse all 535 participating PaedsENGAGE paediatric GP clinics in Singapore by area. Search by neighbourhood, doctor and opening hours, then get Google Maps directions.';

const jsonLd = webSiteSchema();
---

<Base
  title={title}
  description={description}
  canonicalPath="/clinics/"
  jsonLd={jsonLd}
>
  <div class="page-shell">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> › <span>All clinics</span>
    </nav>

    <section class="page-head">
      <h1>All PaedsENGAGE GP clinics in Singapore</h1>
      <p class="lede">
        There are {clinics.length} GP clinics across Singapore taking part in
        the KKH and NUH PaedsENGAGE programme. Choose your area below, or scroll
        for the full list.
      </p>
    </section>

    <section aria-label="Browse by area">
      <div class="section-head"><h2>Browse by area</h2></div>
      <div class="neighbourhood-links">
        {locations.map((l) => (
          <a class="neighbourhood-link" href={`/clinics/${l.slug}/`}>
            <span>Paediatrics clinics in {l.location}</span>
            <span class="count">{l.count}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="clinic-list" style="margin-top:40px" aria-label="All clinics">
      {clinics.map((clinic) => (
        <ClinicCard clinic={clinic} />
      ))}
    </section>
  </div>
</Base>

<style>
  .clinic-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 18px;
  }
</style>