---
// Neighbourhood listing page: /clinics/<location>/
// One page per Singapore neighbourhood with an SEO-optimised title, a list of
// its PaedsENGAGE clinics and ItemList JSON-LD. This is a key local-SEO page:
// parents searching "paediatric GP clinic in <area> Singapore" land here.

import Base from '../../layouts/Base.astro';
import ClinicCard from '../../components/ClinicCard.astro';
import { locations, locationBySlug } from '../../data/clinics';
import { locationListSchema } from '../../data/schema';

export function getStaticPaths() {
  return locations.map((l) => ({ params: { location: l.slug } }));
}

const { location } = Astro.params;
const group = locationBySlug.get(location);

if (!group) {
  return Astro.redirect('/clinics/');
}

const title = `Paediatrics GP clinics in ${group.location}, Singapore - PaedsENGAGE`;
const description = `${group.count} PaedsENGAGE participating paediatric GP clinics in ${
  group.location
}. Compare opening hours, doctors and phone numbers, and get Google Maps directions to skip the hospital queue.`;

const jsonLd = locationListSchema(group);
---

<Base
  title={title}
  description={description}
  canonicalPath={`/clinics/${group.slug}/`}
  jsonLd={jsonLd}
>
  <div class="page-shell">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> › <a href="/clinics/">All clinics</a> ›
      <span>{group.location}</span>
    </nav>

    <section class="page-head">
      <h1>Paediatrics GP clinics in {group.location}, Singapore</h1>
      <p class="lede">
        {group.count} participating PaedsENGAGE GP clinics in {group.location}.
        These KKH and NUH programme clinics see mild to moderate childhood
        conditions in the community, so you can often avoid a long wait at the
        hospital.
      </p>
    </section>

    <section class="clinic-list">
      {group.clinics.map((clinic) => (
        <ClinicCard clinic={clinic} />
      ))}
    </section>

    <section class="neighbourhoods-section" aria-label="Browse other areas">
      <div class="section-head"><h2>Clinics in other areas of Singapore</h2></div>
      <div class="neighbourhood-links">
        {locations
          .filter((l) => l.slug !== group.slug)
          .map((l) => (
            <a class="neighbourhood-link" href={`/clinics/${l.slug}/`}>
              <span>Paediatrics clinics in {l.location}</span>
              <span class="count">{l.count}</span>
            </a>
          ))}
      </div>
    </section>
  </div>
</Base>

<style>
  .neighbourhoods-section {
    margin-top: 48px;
  }
</style>