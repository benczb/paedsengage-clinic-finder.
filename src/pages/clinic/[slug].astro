---
// Clinic detail page: /clinic/<slug>/
// One page per clinic (535 total) with MedicalClinic JSON-LD, unique SEO title,
// opening hours, doctors, phone and a direct Google Maps link. This is the
// primary conversion page: parents search a clinic or "clinic in <area>" and
// land here to get directions without queueing at the hospital.

import Base from '../../layouts/Base.astro';
import {
  clinics,
  clinicBySlug,
  locationBySlug,
  slugify,
  fullDayName,
} from '../../data/clinics';
import { clinicSchema } from '../../data/schema';

export function getStaticPaths() {
  return clinics.map((c) => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const clinic = clinicBySlug.get(slug);

if (!clinic) {
  return Astro.redirect('/clinics/');
}

// The clinic's location group keyed by location slug (not the display name).
const locationGroup = locationBySlug.get(slugify(clinic.location));
// A couple of similar clinics in the same neighbourhood for internal linking.
const similar = (locationGroup ? locationGroup.clinics : [])
  .filter((c) => c.slug !== clinic.slug)
  .slice(0, 4);

const title = `${clinic.clinic_name} - ${clinic.location} | PaedsENGAGE clinic`;
const description = `${clinic.clinic_name} is a PaedsENGAGE participating GP clinic in ${
  clinic.location
}, Singapore (${clinic.address}). See doctors, opening hours and phone number, and get Google Maps directions.`;

const jsonLd = clinicSchema(clinic);
const doctorList = clinic.doctors || [];
const phoneList = clinic.contacts || [];
const primaryPhone = clinic.contact_primary || phoneList[0];
---

<Base
  title={title}
  description={description}
  canonicalPath={`/clinic/${clinic.slug}/`}
  jsonLd={jsonLd}
  type="article"
>
  <div class="page-shell">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> ›{' '}
      <a href="/clinics/">All clinics</a> ›{' '}
      <a href={`/clinics/${locationGroup ? locationGroup.slug : ''}/`}>
        {clinic.location}
      </a>
      {' › '}
      <span>{clinic.clinic_name}</span>
    </nav>

    <section class="page-head">
      <h1>{clinic.clinic_name}</h1>
      <p class="lede">
        PaedsENGAGE participating GP clinic in {clinic.location}, Singapore.
        Alert the clinic that you may be coming (they can see mild to moderate
        childhood conditions on the KKH / NUH programme and reduce your wait at
        the hospital).
      </p>
    </section>

    <div class="detail-grid">
      <div class="detail-main">
        <div class="detail-card">
          <h2>Address</h2>
          <p>{clinic.address}</p>
          <a
            class="maps-cta"
            href={clinic.google_maps_url}
            target="_blank"
            rel="noreferrer noopener"
            aria-label={`Get directions to ${clinic.clinic_name} on Google Maps`}
          >
            Open in Google Maps ↗
          </a>
        </div>

        <div class="detail-card" style="margin-top:18px">
          <h2>Opening hours</h2>
          <div class="hours-list">
            {(clinic.schedule?.days || []).map((d) => (
              <div class="hours-row">
                <strong>{fullDayName(d.day)}</strong>
                <div>
                  {(d.time_blocks || []).map((b) => b.display).join(', ') ||
                    'Closed'}
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="detail-card" style="margin-top:18px">
          <h2>Doctors</h2>
          {doctorList.length ? (
            <ul class="doctors-list">
              {doctorList.map((doc) => (
                <li>{doc}</li>
              ))}
            </ul>
          ) : (
            <p class="muted">Not listed - call the clinic to confirm.</p>
          )}
        </div>

        <div class="detail-card" style="margin-top:18px">
          <h2>Contact</h2>
          {phoneList.length ? (
            <ul class="phones-list">
              {phoneList.map((phone, i) => (
                <li>
                  <a href={`tel:+65${phone}`}>
                    {i === 0 ? primaryPhone || phone : phone}
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="muted">Phone number not listed.</p>
          )}
        </div>

        <div class="disclaimer" style="margin-top:18px">
          <strong>Note:</strong> Contact details and hours are based on the
          Participating PaedsENGAGE Clinics PDF (accurate as of 03 Aug 2026).
          Always confirm doctor availability and opening hours with the clinic
          before visiting.
        </div>
      </div>

      {similar.length > 0 && (
        <aside class="related-clinics detail-card">
          <h2>Nearby clinics in {clinic.location}</h2>
          <div class="similar-clinics-list">
            {similar.map((c) => (
              <div class="similar-clinic">
                <a href={`/clinic/${c.slug}/`}>{c.clinic_name}</a>
                <div class="muted" style="font-size:0.85rem">
                  {c.address}
                </div>
              </div>
            ))}
          </div>
        </aside>
      )}
    </div>
  </div>
</Base>

<style>
  .detail-card .muted {
    color: var(--muted);
  }
  .muted {
    color: var(--muted);
  }
</style>