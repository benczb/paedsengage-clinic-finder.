---
// Base layout: shared HTML shell with comprehensive, per-page SEO head tags.
// Every page passes a `seo` object so the title, description, canonical,
// Open Graph and Twitter tags are unique per page (the single biggest SEO win
// over the old single-title SPA).
import '../styles/global.css';

const SITE = 'https://childandkid.com';

const {
  title,
  description,
  canonicalPath,
  ogImage = `${SITE}/og-default.svg`,
  jsonLd = null,
  noindex = false,
  type = 'website',
} = Astro.props;

const canonical =
  canonicalPath && canonicalPath !== '/'
    ? `${SITE}${canonicalPath.replace(/\/?$/, '/')}`
    : `${SITE}/`;
const fullTitle = title
  .toLowerCase()
  .includes('paedsengage')
  ? title
  : `${title} | PaedsEngage Clinic Finder`;
const jsonLdString = jsonLd
  ? `<script type="application/ld+json">${JSON.stringify(jsonLd)}</script>`
  : '';
---

<!doctype html>
<html lang="en-SG">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta
      name="description"
      content={description}
    />

    <!-- Canonical -->
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:site_name" content="PaedsEngage Clinic Finder" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_SG" />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Geo / local hints -->
    <meta name="geo.region" content="SG" />
    <meta name="geo.placename" content="Singapore" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- Performance: preload critical fonts, defer non-blocking -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />

    {jsonLdString && <Fragment set:html={jsonLdString} />}

    <style is:global>{`html{scroll-behavior:smooth}`}</style>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <!-- Google Analytics (gtag.js) - kept same ID as current site -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-HRXBRR9J6H"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-HRXBRR9J6H');
    </script>

    <header class="top-nav">
      <a class="brand" href="/" aria-label="PaedsEngage home">
        <span class="brand-mark" aria-hidden="true">♡</span>
        <span>Paeds<span>Engage</span></span>
      </a>
      <nav class="nav-links" aria-label="Main navigation">
        <a href="/#about">About</a>
        <a href="/clinics/">Clinics</a>
        <a href="/about/">About this site</a>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div>
        <p class="eyebrow footer-eyebrow">About this site</p>
        <p class="footer-copy">
          This independent directory is not affiliated with or endorsed by KKH, NUH, or PaedsENGAGE.
          Clinic information is based on publicly available PaedsENGAGE materials and should be
          verified with the clinic before visiting.
        </p>
      </div>
      <div class="footer-links">
        <a class="footer-link" href="/about/">About this site</a>
        <a
          class="footer-link"
          href="https://www.linkedin.com/in/ben-cheng"
          target="_blank"
          rel="noreferrer"
          aria-label="LinkedIn"
        >
          <span class="social-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" role="img" focusable="false" width="18" height="18">
              <path
                d="M6.94 8.5H3.56V19h3.38V8.5ZM5.25 3A1.97 1.97 0 0 0 3.3 4.97c0 1.08.87 1.96 1.95 1.96h.02c1.1 0 1.97-.88 1.97-1.96A1.97 1.97 0 0 0 5.27 3h-.02ZM21 12.55c0-3.19-1.7-4.67-3.97-4.67-1.83 0-2.65 1-3.11 1.7V8.5h-3.37c.04.72 0 10.5 0 10.5h3.37v-5.87c0-.32.02-.63.12-.85.25-.63.82-1.28 1.78-1.28 1.26 0 1.76.96 1.76 2.37V19H21v-6.45Z"
                fill="currentColor"
              />
            </svg>
          </span>
        </a>
      </div>
    </footer>
  </body>
</html>