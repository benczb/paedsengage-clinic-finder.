---
// ClinicCard: reusable, SEO-friendly clinic card used on the neighbourhood
// listing pages and the all-clinics finder. Each card links to the clinic's
// own detail page (/-/clinic/<slug>/) and to Google Maps.
import { fullDayName } from '../data/clinics';

const { clinic, showHours = false } = Astro.props;
const doctorText = (clinic.doctors || []).join(', ');
const phoneText = (clinic.contacts || []).join(' / ') || 'Not listed';
const hoursHtml = clinic.schedule?.days
  ? clinic.schedule.days
      .map((d) => {
        const times =
          (d.time_blocks || []).map((b) => b.display).join(', ') || 'Closed';
        return `<div class="hours-row"><strong>${fullDayName(d.day)}</strong><div>${times}</div></div>`;
      })
      .join('')
  : '';
---

<article class="card">
  <h3>
    <a href={`/clinic/${clinic.slug}/`}>{clinic.clinic_name}</a>
  </h3>
  <p class="clinic-meta">
    <strong>{clinic.location}</strong><br />
    {clinic.address}
  </p>
  <div class="tag-row">
    <span class="tag">{phoneText}</span>
    {doctorText && <span class="tag">{doctorText}</span>}
  </div>
  {showHours && hoursHtml && (
    <div class="hours-list" set:html={hoursHtml} />
  )}
  <a
    class="detail-link"
    href={`/clinic/${clinic.slug}/`}
    aria-label={`View ${clinic.clinic_name} clinic details`}
  >
    View clinic details ↗
  </a>
  <a
    class="maps-link"
    href={clinic.google_maps_url}
    target="_blank"
    rel="noreferrer noopener"
    aria-label={`Open ${clinic.clinic_name} in Google Maps`}
  >
    Open in Google Maps ↗
  </a>
</article>

<style>
  .maps-link {
    display: block;
    color: var(--brand-dark);
    font-weight: 600;
    font-size: 0.92rem;
    margin-top: 4px;
  }
</style>